# Environment configuration
#
# Every variable here is optional: the application falls back to sensible
# defaults if none are set. All of them are NEXT_PUBLIC_*, meaning they are
# inlined into the client bundle and are therefore NOT secret. Never put an API
# key, a private key, or a recovery phrase in this file.

# Allows pnpm to run dependency build scripts during a Vercel production build.
PNPM_APPROVE_BUILD=true

# Block explorer used by the Converter and Generator panels.
# The variable names must end in _URL — this is what lib/ethers.ts reads.
NEXT_PUBLIC_ROUTESCAN_MAINNET_URL=https://routescan.io
NEXT_PUBLIC_ROUTESCAN_TESTNET_URL=https://testnet.routescan.io

# Reown (WalletConnect) project id for the wallet-side connection panel.
# A public client identifier, not a secret. Defaults to the project owner's
# id when unset; register your own at https://cloud.reown.com if forking.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Infura project id used by the built-in network RPC lists.
# A public client identifier, not a secret (it appears in every RPC request
# URL). Defaults to the project owner's id when unset. If you run your own
# project, also restrict it to your domains in the Infura dashboard under
# Settings > Security — that allowlist lives in the Infura account and
# cannot be configured from this repository.
# NEXT_PUBLIC_INFURA_PROJECT_ID=
