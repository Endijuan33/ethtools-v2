# Environment configuration
#
# Every variable here is optional: the application falls back to sensible
# defaults if none are set. All of them are NEXT_PUBLIC_*, meaning they are
# inlined into the client bundle and are therefore NOT secret. Never put an API
# key, a private key, or a recovery phrase in this file.

# Allows pnpm to run dependency build scripts during a Vercel production build.
PNPM_APPROVE_BUILD=true

# Block explorer used by the Converter and Generator panels.
# The variable names must end in _URL — this is what lib/ethers.ts reads.
NEXT_PUBLIC_ROUTESCAN_MAINNET_URL=https://routescan.io
NEXT_PUBLIC_ROUTESCAN_TESTNET_URL=https://testnet.routescan.io
